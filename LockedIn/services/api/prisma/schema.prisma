generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

enum RelationshipStatus {
  ACTIVE
  ENDED
  BLOCKED
}

enum IntentionSessionStatus {
  COLLECTING
  READY_TO_REVEAL
  REVEALED
  ACTION_CHOSEN
  REFLECTED
  ARCHIVED
}

enum NextStepStatus {
  PROPOSED
  ACCEPTED
  COMPLETED
  PAUSED
  REVISED
  DECLINED
}

enum ReflectionOutcome {
  COMPLETED
  CHANGED
  PAUSED
  NOT_RELEVANT
}

enum MeaningChapterStatus {
  COLLECTING
  DISCOVERING
  CHECKING
  PROPOSING
  CHOOSING
  RESOLVING
  PROPOSED
  SHARED
}

enum MeaningCheckStatus {
  PENDING
  CONFIRMED
  ALMOST
  MISSING
}

enum MeaningProposalKind {
  PERSONAL
  BLEND
  REVISION
  PAIRED
}

enum MeaningSelectionMode {
  PROPOSAL
  BLEND
  KEEP_BOTH
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?  @unique
  displayName   String?
  username      String?  @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  avatarPreset  String   @default("initials")
  activityEmails Boolean @default(true)
  inAppActivity Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invitesSent                RelationshipInvite[]        @relation("sentInvites")
  invitesReceived            RelationshipInvite[]        @relation("receivedInvites")
  relationshipMemberships    RelationshipMember[]
  intentionSessionsCreated   IntentionSession[]          @relation("IntentionSessionCreator")
  intentionResponses         IntentionResponse[]
  proposedNextSteps          SharedNextStep[]            @relation("NextStepProposer")
  reflections                Reflection[]
  conversationChoices        ConversationChoice[]
  meaningChaptersCreated     MeaningChapter[]            @relation("MeaningChapterCreator")
  meaningDefinitionsProposed MeaningChapter[]            @relation("MeaningDefinitionProposer")
  meaningResponses           MeaningResponse[]
  meaningDefinitionProposals MeaningDefinitionProposal[]
  meaningSelections          MeaningSelection[]
  meaningFinalApprovals      MeaningFinalApproval[]
  sessions                   Session[]
  accounts                   Account[]
  notifications              Notification[]
  invitationBlocksCreated    InvitationBlock[] @relation("InvitationBlockOwner")
  invitationBlocksReceived   InvitationBlock[] @relation("InvitationBlockTarget")
  discoveryProfile           DiscoveryProfile?
  discoveryConnectionsLow    DiscoveryConnection[]       @relation("DiscoveryLowUser")
  discoveryConnectionsHigh   DiscoveryConnection[]       @relation("DiscoveryHighUser")
  discoveryInvitationsSent   DiscoveryConnection[]       @relation("DiscoveryInviter")
  discoveryDrafts            DiscoveryDraft[]
  discoverySharedResponses   DiscoverySharedResponse[]
  discoveryMessages          DiscoveryMessage[]
  privateReflection          PrivateReflection?
  discoveryReportsCreated    DiscoveryReport[]           @relation("DiscoveryReporter")
  discoveryReportsReceived   DiscoveryReport[]           @relation("DiscoveryReported")
  discoveryModerationActions DiscoveryModerationAudit[]  @relation("DiscoveryModerator")
  discoveryModerationTargets DiscoveryModerationAudit[]  @relation("DiscoveryModerated")
  discoveryPhotos            DiscoveryPhoto[]
  discoveryPhotoAudits       DiscoveryPhotoAudit[]
  discoveryThrottles         DiscoveryThrottle[]
  chatConversationsLow       ChatConversation[] @relation("ChatLowUser")
  chatConversationsHigh      ChatConversation[] @relation("ChatHighUser")
  chatReadStates             ChatReadState[]
  dateSpotPreference         DateSpotPreference?
  dateSpotRequests           DateSpotRequest[]
  proposedDates              ChatDatePlan[]

  @@map("user")
}

model RelationshipInvite {
  id           String       @id @default(uuid())
  inviterId    String
  inviteeId    String?
  inviteeEmail String?
  token        String       @unique @default(uuid())
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime?
  acceptedAt   DateTime?
  declinedAt   DateTime?
  withdrawnAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  inviter User  @relation("sentInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("receivedInvites", fields: [inviteeId], references: [id], onDelete: Cascade)
  notifications Notification[]
  chatConversation ChatConversation?

  @@index([inviterId])
  @@index([inviteeId])
  @@index([inviteeEmail, status])
  @@index([inviterId, inviteeId, declinedAt])
}

model InvitationBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  safePublicLabel String?
  blocker User @relation("InvitationBlockOwner",fields:[blockerId],references:[id],onDelete:Cascade)
  blocked User @relation("InvitationBlockTarget",fields:[blockedId],references:[id],onDelete:Cascade)

  @@unique([blockerId,blockedId])
  @@index([blockedId])
}

model Relationship {
  id        String             @id @default(uuid())
  status    RelationshipStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  members             RelationshipMember[]
  intentionSessions   IntentionSession[]
  conversationChoices ConversationChoice[]
  meaningChapters     MeaningChapter[]
  notifications       Notification[]
  discoveryConnection DiscoveryConnection?
  chatConversation    ChatConversation?
}

model Notification {
  suppressed     Boolean      @default(false)
  id             BigInt       @id @default(autoincrement())
  recipientId    String
  relationshipId String?
  invitationId   String?
  discoveryConnectionId String?
  kind           String
  entityId       String
  wordKey        String?
  eventKey       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  readAt         DateTime?
  resolvedAt     DateTime?
  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  invitation     RelationshipInvite? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  discoveryConnection   DiscoveryConnection? @relation(fields: [discoveryConnectionId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventKey])
  @@index([recipientId, id])
  @@index([relationshipId])
  @@index([invitationId])
  @@index([discoveryConnectionId])
}

enum DiscoveryConnectionState {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
  CLOSED
  PROMOTED
}

model DiscoveryProfile {
  id                        String    @id @default(uuid())
  ownerId                   String    @unique
  draft                     Json
  publishedSnapshot         Json?
  publishedAreaId           String?
  publishedIntention        String?
  publicationVersion        Int       @default(0)
  publicationConsentVersion Int?
  publicationConsentedAt    DateTime?
  adultAttestedAt           DateTime?
  publishedAt               DateTime?
  lastDiscoveryActiveOn     DateTime? @db.Date
  pausedAt                  DateTime?
  suspendedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  owner                     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos                    DiscoveryPhoto[]
  distancePreference        DiscoveryDistancePreference?
  locationCheck             DiscoveryLocationCheck?

  @@index([publishedAreaId, publishedIntention])
  @@unique([id, ownerId])
}

model DiscoveryLocationCheck {
  profileId String           @id
  areaId    String
  expiresAt DateTime
  profile   DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([areaId, expiresAt])
}

model DiscoveryDistancePreference {
  profileId        String           @id
  latitude         Float
  longitude        Float
  maxDistanceMiles Int
  areaLabel        String?
  revision         String           @default(uuid())
  profile          DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([latitude])
}

enum DiscoveryPhotoState {
  PROCESSING
  APPROVED
  NEEDS_REVIEW
  REJECTED
  CHECK_FAILED
}

enum DiscoveryPhotoJobKind {
  RECONCILE
  DESTROY
}

model DiscoveryPhoto {
  id               String              @id @default(uuid())
  ownerId          String
  profileId        String
  requestId        String
  payloadHash      String
  state            DiscoveryPhotoState @default(PROCESSING)
  decisionRevision Int                 @default(1)
  assetId          String?
  publicId         String?             @unique
  assetVersion     Int?
  width            Int?
  height           Int?
  policyVersion    String?
  screening        Json?
  scanCompleted    Boolean             @default(false)
  reason           String              @default("Checking photo")
  expectedRevision Int                 @default(0)
  replacePhotoId   String?
  appealedRevision Int?
  deletedAt        DateTime?
  revokedAt        DateTime?
  destroyedAt      DateTime?
  retentionUntil   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  owner            User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  profile          DiscoveryProfile    @relation(fields: [profileId, ownerId], references: [id, ownerId], onDelete: Restrict)
  jobs             DiscoveryPhotoJob[]
  audits           DiscoveryPhotoAudit[]
  reports          DiscoveryReport[]

  @@unique([ownerId, requestId])
  @@index([ownerId, state])
  @@index([state, createdAt])
}

model DiscoveryPhotoJob {
  id          String                @id @default(uuid())
  photoId     String
  kind        DiscoveryPhotoJobKind
  dedupeKey   String                @unique
  dueAt       DateTime              @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  attempts    Int                   @default(0)
  lastError   String?
  failedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  photo       DiscoveryPhoto        @relation(fields: [photoId], references: [id], onDelete: Restrict)

  @@index([completedAt, failedAt, dueAt])
}

model DiscoveryPhotoAudit {
  id               String         @id @default(uuid())
  photoId          String
  actorId          String
  action           String
  reason           String
  requestId        String
  decisionRevision Int
  createdAt        DateTime       @default(now())
  photo            DiscoveryPhoto @relation(fields: [photoId], references: [id], onDelete: Restrict)
  actor            User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
  @@index([photoId, createdAt])
}

model DiscoveryConnection {
  id                   String                    @id @default(uuid())
  userLowId            String
  userHighId           String
  inviterId            String
  requestId            String?
  questionKey          String
  questionText         String
  hello                String
  senderPublicName     String
  senderAvatarPreset   String
  state                DiscoveryConnectionState  @default(PENDING)
  expiresAt            DateTime
  declinedAt           DateTime?
  acceptedAt           DateTime?
  closedAt             DateTime?
  lowReadinessVersion  Int?
  highReadinessVersion Int?
  consentVersion       Int                       @default(1)
  lowLockInVersion     Int?
  highLockInVersion    Int?
  lockedInAt           DateTime?
  legacyUnreadBaseline BigInt?
  relationshipId       String?                   @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  userLow              User                      @relation("DiscoveryLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh             User                      @relation("DiscoveryHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  inviter              User                      @relation("DiscoveryInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  relationship         Relationship?             @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  drafts               DiscoveryDraft[]
  sharedResponses      DiscoverySharedResponse[]
  messages             DiscoveryMessage[]
  reports              DiscoveryReport[]
  notifications        Notification[]
  chatConversation     ChatConversation?

  @@index([userLowId, state])
  @@unique([inviterId, requestId])
  @@index([userHighId, state])
  @@index([inviterId, userLowId, userHighId, declinedAt], map: "DiscoveryConnection_directional_decline_idx")
}

enum ChatOrigin {
  DISCOVERY
  DIRECT_INVITATION
  LEGACY_RELATIONSHIP
}

enum ChatAccessMode {
  DISCOVERY
  RELATIONSHIP
}

model ChatConversation {
  id                    String @id @default(uuid())
  userLowId             String
  userHighId            String
  origin                ChatOrigin
  accessMode            ChatAccessMode
  discoveryConnectionId String? @unique
  relationshipId        String? @unique
  directInvitationId    String? @unique
  closedAt              DateTime?
  closureReason         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userLow               User @relation("ChatLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh              User @relation("ChatHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  discoveryConnection   DiscoveryConnection? @relation(fields: [discoveryConnectionId], references: [id], onDelete: SetNull)
  relationship          Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  directInvitation      RelationshipInvite? @relation(fields: [directInvitationId], references: [id], onDelete: SetNull)
  messages              DiscoveryMessage[]
  reports               DiscoveryReport[]
  dateSpotRequest       DateSpotRequest?
  datePlans             ChatDatePlan[]
  readStates            ChatReadState[]

  @@index([userLowId])
  @@index([userHighId])
}

model ChatReadState {
  conversationId String
  userId         String
  through        BigInt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model DateSpotPreference {
  userId     String @id
  areaId     String
  interests  String[]
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DateSpotRequest {
  conversationId String @id
  id             String @unique @default(uuid())
  initiatorId    String
  startsWith     Json
  joinsWith      Json?
  expiresAt      DateTime
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator      User @relation(fields: [initiatorId], references: [id], onDelete: Cascade)

  @@index([initiatorId])
}

enum ChatDatePlanStatus {
  pending
  confirmed
  declined
  withdrawn
  canceled
}

model ChatDatePlan {
  id              String             @id @default(uuid())
  conversationId  String
  sourceMessageId String
  venueName       String
  venuePlaceId    String?
  startsAt        DateTime
  timeZone        String
  revision        Int
  proposerId      String
  state           ChatDatePlanStatus
  confirmedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  conversation    ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage   DiscoveryMessage   @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  proposer        User               @relation(fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([conversationId, state, startsAt])
  @@index([sourceMessageId])
  @@index([proposerId])
}

model DiscoveryMessage {
  id           String              @id @default(uuid())
  sequence     BigInt              @unique @default(autoincrement())
  connectionId String?
  conversationId String?
  senderId     String
  requestId    String
  text         String
  dateSpotPlaceId String?
  datePlanEvent Json?
  unreadAlertSuppressed Boolean @default(false)
  createdAt    DateTime            @default(now())
  connection   DiscoveryConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  anchoredDatePlans ChatDatePlan[]

  @@unique([connectionId, senderId, requestId])
  @@unique([conversationId, senderId, requestId])
  @@index([conversationId, sequence])
  @@index([connectionId, sequence])
  @@index([senderId])
}

model DiscoveryDraft {
  id           String              @id @default(uuid())
  connectionId String
  ownerId      String
  text         String
  revision     Int                 @default(1)
  updatedAt    DateTime            @updatedAt
  connection   DiscoveryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ownerId])
  @@index([ownerId])
}

model DiscoverySharedResponse {
  id           String              @id @default(uuid())
  connectionId String
  ownerId      String
  requestId    String
  text         String
  version      Int
  sharedAt     DateTime            @default(now())
  connection   DiscoveryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ownerId, requestId])
  @@unique([connectionId, ownerId, version])
  @@index([ownerId])
}

model PrivateReflection {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  text      String
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model DiscoveryReport {
  id               String                     @id @default(uuid())
  reporterId       String
  reportedUserId   String
  connectionId     String?
  conversationId   String?
  reason           String
  details          String?
  requestId        String?
  sourceType       String?
  sourceId         String?
  evidence         Json?
  createdAt        DateTime                   @default(now())
  resolvedAt       DateTime?
  photoId          String?
  photoVersion     Int?
  photo            DiscoveryPhoto?            @relation(fields: [photoId], references: [id], onDelete: Restrict)
  reporter         User                       @relation("DiscoveryReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser     User                       @relation("DiscoveryReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  connection       DiscoveryConnection?       @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  conversation     ChatConversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  moderationAudits DiscoveryModerationAudit[]

  @@index([resolvedAt, createdAt])
  @@index([photoId, resolvedAt])
  @@index([reporterId])
  @@index([conversationId])
  @@index([reportedUserId])
  @@unique([reporterId, requestId])
}

model DiscoveryModerationAudit {
  id           String           @id @default(uuid())
  moderatorId  String
  targetUserId String
  reportId     String?
  action       String
  reason       String
  requestId    String?
  createdAt    DateTime         @default(now())
  moderator    User             @relation("DiscoveryModerator", fields: [moderatorId], references: [id], onDelete: Restrict)
  targetUser   User             @relation("DiscoveryModerated", fields: [targetUserId], references: [id], onDelete: Restrict)
  report       DiscoveryReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([moderatorId])
  @@unique([moderatorId, requestId])
}

model DiscoveryThrottle {
  id          String   @id @default(uuid())
  userId      String
  action      String
  windowStart DateTime
  count       Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, windowStart])
}

model MeaningChapter {
  id                           String               @id @default(uuid())
  relationshipId               String
  wordKey                      String
  createdById                  String
  status                       MeaningChapterStatus @default(COLLECTING)
  sharedDefinition             String?
  sharedDefinitionProposedById String?
  candidateVersion             Int                  @default(0)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  relationship               Relationship                @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  createdBy                  User                        @relation("MeaningChapterCreator", fields: [createdById], references: [id], onDelete: Cascade)
  sharedDefinitionProposedBy User?                       @relation("MeaningDefinitionProposer", fields: [sharedDefinitionProposedById], references: [id], onDelete: SetNull)
  responses                  MeaningResponse[]
  proposals                  MeaningDefinitionProposal[]
  selections                 MeaningSelection[]
  finalApprovals             MeaningFinalApproval[]

  @@index([relationshipId, wordKey, createdAt])
  @@index([createdById])
}

model MeaningDefinitionProposal {
  id         String              @id @default(uuid())
  chapterId  String
  userId     String?
  kind       MeaningProposalKind
  definition String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  chapter    MeaningChapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  selections MeaningSelection[]

  @@index([chapterId, kind, createdAt])
  @@index([userId])
}

model MeaningSelection {
  id         String               @id @default(uuid())
  chapterId  String
  userId     String
  mode       MeaningSelectionMode
  proposalId String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  chapter  MeaningChapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal MeaningDefinitionProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@unique([chapterId, userId])
  @@index([proposalId])
}

model MeaningFinalApproval {
  id               String   @id @default(uuid())
  chapterId        String
  userId           String
  candidateVersion Int
  createdAt        DateTime @default(now())

  chapter MeaningChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chapterId, userId, candidateVersion])
  @@index([chapterId, candidateVersion])
}

model MeaningResponse {
  id           String              @id @default(uuid())
  chapterId    String
  userId       String
  definition   String
  example      String
  notMeaning   String
  heardSummary String?
  heardStatus  MeaningCheckStatus?
  submittedAt  DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  chapter MeaningChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chapterId, userId])
  @@index([userId])
}

model ConversationChoice {
  id             String   @id @default(uuid())
  relationshipId String
  userId         String
  packKey        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, userId])
  @@index([relationshipId])
  @@index([userId])
}

model RelationshipMember {
  id             String @id @default(uuid())
  relationshipId String
  userId         String

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, userId])
  @@index([relationshipId])
  @@index([userId])
}

model IntentionSession {
  id             String                 @id @default(uuid())
  relationshipId String
  createdById    String
  topic          String                 @default("Our next 12 months")
  packKey        String                 @default("direction")
  status         IntentionSessionStatus @default(COLLECTING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  relationship Relationship        @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("IntentionSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  responses    IntentionResponse[]
  nextSteps    SharedNextStep[]

  @@index([relationshipId, status])
  @@index([createdById])
}

model IntentionResponse {
  id                String    @id @default(uuid())
  sessionId         String
  userId            String
  answers           Json
  shareKeys         String[]
  contextNotes      Json      @default("{}")
  contextShareKeys  String[]  @default([])
  submittedAt       DateTime  @default(now())
  revealConsentedAt DateTime?
  updatedAt         DateTime  @updatedAt

  session IntentionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model SharedNextStep {
  id           String         @id @default(uuid())
  sessionId    String
  proposedById String
  title        String
  details      String?
  targetDate   DateTime?
  status       NextStepStatus @default(PROPOSED)
  acceptedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  session     IntentionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proposedBy  User             @relation("NextStepProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  reflections Reflection[]

  @@index([sessionId, status])
  @@index([proposedById])
}

model Reflection {
  id         String            @id @default(uuid())
  nextStepId String
  userId     String
  outcome    ReflectionOutcome
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  nextStep SharedNextStep @relation(fields: [nextStepId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nextStepId, userId])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
