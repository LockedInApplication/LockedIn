POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lockedin
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lockedin

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8000
APP_URL=http://localhost:3001
REQUIRE_EMAIL_VERIFICATION=false

RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Discovery remains off until separately approved for rollout.
DISCOVERY_ENABLED=false
# pilot (default): explicit account allowlist. open: verified accounts may opt in.
# Invalid values close new admission. Neither mode auto-publishes profiles.
DISCOVERY_ACCESS_MODE=pilot
DISCOVERY_PILOT_USER_IDS=
DISCOVERY_MODERATOR_USER_IDS=
DISCOVERY_AREAS_JSON=[]
# Opt-in Discovery text chat. Apply the chat migration before enabling it.
DISCOVERY_CHAT_ENABLED=false
# Shared invited-partner chat: expand schema, upgrade every safety writer, then
# run backfill/check before enabling. See docs/shared-messaging-rollout.md.
SHARED_MESSAGING_ENABLED=false

# Optional, server-only key for Geoapify Discovery location lookups.
DISCOVERY_GEOAPIFY_API_KEY=
